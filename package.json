{
  "name": "flexigotravel-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:admin": "npm --workspace apps/admin run dev",
    "dev:driver": "npm --workspace apps/driver run dev",
    "build": "npm run build:web",
    "build:web": "npm --workspace apps/web run build",
    "build:admin": "npm --workspace apps/admin run build",
    "build:driver": "npm --workspace apps/driver run build",
    "lint": "npm run lint:web",
    "lint:web": "npm --workspace apps/web run lint",
    "lint:admin": "npm --workspace apps/admin run lint",
    "lint:driver": "npm --workspace apps/driver run lint"
  }
}
